# ─── Bildung .gitignore ───

# System / sync
.stversions/
.stfolder/
.git/

# Artefacto runtime de la EAL (mapea el árbol; reaparece)
on
on/

# ─── Contenido NO versionado en bildung ───
# lab/            → proyectos en gradiente (la carpeta codifica el estado)
# activos/        → opera sin intervención
# infraestructura/→ modifica al sistema
# referencia/     → clones externos (historial vive en upstream)
lab/
activos/
infraestructura/
referencia/

# ─── Docs: solo specs, no histórico ───
docs/archive/

# ─── Caché ───
*.pyc
__pycache__/
venv/
node_modules/
.env
